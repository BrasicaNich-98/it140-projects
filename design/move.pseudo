# Project One Move-Between-Rooms Pseudocode



START move_between_rooms

   SET current_room = "Jungle Entrance"

   WHILE game is running

       OUTPUT "Current room: " + current_room
       INPUT "Enter direction (North,South, East, West): INTO direction

        IF  direction is a valid direction from current_room
             SET current_room = room in direction
             OUTPUT "You moved to " + current_room
     ELSE
       OUTPUT "You cannot go that way. Try another direction."
     END IF

  END WHILE
END move_between_rooms


