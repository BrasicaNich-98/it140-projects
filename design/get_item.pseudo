# Project One Get-Item Pseudocode


START get_item

     SET current_item = item in current_room
    

    OUTPUT "Current room: " + current_room
    OUTPUT "Inventory: " + inventory
    OUTPUT "Item available: " + current_item

    INPUT "Enter item to collect: " INTO item_request

    IF item_request = current_item THEN
          ADD current_item to inventory
          REMOVE current_item from current_room
          OUTPUT current_item + " added to inventory."
    ELSE
        OUTPUT "That item is not available in this room."
    END IF

    RETURN to game

END get_item




